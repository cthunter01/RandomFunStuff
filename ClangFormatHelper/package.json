{
    "name": "clang-format-helper",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Interactive .clang-format configuration builder powered by real clang-format compiled to WebAssembly",
    "scripts": {
        "dev": "vite",
        "build": "npm run tidy:fetch && npm run catalog:check && npm run tidy-catalog:check && tsc -b --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -b --noEmit",
        "catalog:generate": "tsx scripts/generate-catalog.ts",
        "catalog:check": "tsx scripts/generate-catalog.ts --check",
        "tidy-catalog:generate": "tsx scripts/generate-tidy-catalog.ts",
        "tidy-catalog:check": "tsx scripts/generate-tidy-catalog.ts --check",
        "tidy:fetch": "tsx scripts/fetch-clang-tidy.ts",
        "tidy:build": "tools/clang-tidy-wasm/build.sh",
        "test:e2e": "tsx tests/e2e/smoke.mts",
        "release": "npm run build && tsx scripts/precompress.ts",
        "check:deploy": "tsx scripts/check-deployment.ts"
    },
    "dependencies": {
        "@bjorn3/browser_wasi_shim": "^0.4.2",
        "@codemirror/commands": "^6.8.1",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.11.3",
        "@codemirror/merge": "^6.12.2",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.43.12",
        "@wasm-fmt/clang-format": "23.1.1",
        "js-yaml": "^4.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^26.6.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.4",
        "puppeteer-core": "^25.11.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vite": "^7.1.9",
        "vitest": "^3.2.4"
    }
}
